{
  "name": "ai-interactive-classroom",
  "version": "0.1.0",
  "private": true,
  "description": "AI Interactive Classroom — browser-based whiteboard, math viz, realtime rooms, AI assistant",
  "scripts": {
    "build": "pnpm -r build",
    "test:web": "pnpm --filter @ai-classroom/web test --run",
    "test:packages": "pnpm -r --filter './packages/**' test",
    "test:all": "pnpm test:packages && pnpm test:web",
    "dev:web": "pnpm --filter @ai-classroom/web dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@11.5.2",
  "pnpm": {
    "overrides": {
      "vite": "^6.0.3"
    }
  }
}
