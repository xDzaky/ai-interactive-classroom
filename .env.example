# =============================================================================
# AI Interactive Classroom — Root .env.example
# Copy to .env and fill in values. NEVER commit .env with real secrets.
# =============================================================================

# Docker Compose
COMPOSE_PROJECT_NAME=ai-classroom

# PostgreSQL (used by docker-compose.yml)
POSTGRES_DB=classroom
POSTGRES_USER=classroom
POSTGRES_PASSWORD=secret

# Redis
REDIS_PASSWORD=
